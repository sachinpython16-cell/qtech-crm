# ==============================================================================
# QtechCRM Backend - Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development.
# 2. Never commit '.env' containing real secrets to version control!
# 3. For production, generate a secure 64-character SECRET_KEY using:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="QtechCRM"
# Docker Compose Project / Stack Name (Used in Docker Desktop to group containers)
COMPOSE_PROJECT_NAME="qtech-crm"
# Options: development | staging | production
ENVIRONMENT="development"
# Set to False in production to disable verbose tracebacks
DEBUG=True
# Set to False in production if API documentation (/docs and /redoc) should be private
ENABLE_DOCS=True

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
# MANDATORY: 256-bit cryptographically random hex secret key for signing JWTs
# Replace this with your own generated key in production!
SECRET_KEY="45ffc1e806f5004f5911291990c8a026ba7a6165e4071d7c5c842be8b71ec6df"
ALGORITHM="HS256"
# Access token validity in minutes (recommended: 15 to 60)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token validity in minutes (10080 = 7 days)
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes)
# In production, replace with your frontend domain(s)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# When using Docker Compose, the database server host is typically 'db'
# When running locally without Docker, use 'localhost'
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_postgres_password"
POSTGRES_DB="qtech_crm_db"

# Optional: Directly provide full connection string (overrides the above individual parameters)
# DATABASE_URL="postgresql+psycopg2://postgres:your_secure_postgres_password@db:5432/qtech_crm_db"

# ------------------------------------------------------------------------------
# 5. Database Connection Pool Settings (Optimized for High Concurrency)
# ------------------------------------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Recycle connections periodically (in seconds) to prevent stale connections
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 6. Server Runtime Configuration
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
# Recommended workers in production: (2 x CPU cores) + 1
WORKERS=4
